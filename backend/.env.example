# ============================================
# AI 模型中转站 - 环境变量配置示例
# ============================================
# 复制此文件为 .env 并修改相应的配置值
# cp .env.example .env

# ============================================
# 数据库配置
# ============================================
# PostgreSQL 数据库连接 URL
# 格式: postgresql+asyncpg://用户名:密码@主机:端口/数据库名
# 注意: 数据库如果不存在，请先运行 python init_db.py 创建
DATABASE_URL=postgresql+asyncpg://postgres:POSTGRESQL_PASSWORD@127.0.0.1:5433/proxy_openai

# ============================================
# 加密配置
# ============================================
# API Key 加密密钥（必须修改！）
# 建议使用随机生成的密钥，长度至少 32 字符
# 可以使用以下命令生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=your-secret-key-change-in-production-min-32-chars

# ============================================
# CORS 配置
# ============================================
# 允许的前端域名，多个用逗号分隔
# 开发环境示例: http://localhost:5173,http://localhost:3000
# 生产环境请修改为实际的前端域名
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# 应用配置
# ============================================
# 应用名称
APP_NAME=AI Proxy Server

# 调试模式 (true/false)
# 生产环境请设置为 false
DEBUG=false
